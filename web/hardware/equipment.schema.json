{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reforge:equipment:1",
  "title": "Equipment list",
  "type": "object",
  "required": ["schema", "name", "devices"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "reforge-equipment/1"},
    "name": {"$ref": "#/$defs/text"},
    "devices": {
      "type": "array", "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["id", "name", "role", "interface"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{1,64}$"},
          "name": {"$ref": "#/$defs/text"},
          "role": {"$ref": "#/$defs/text"},
          "interface": {"type": "string", "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f]*$"}
        }
      }
    }
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f]*\\S[^\\u0000-\\u001f\\u007f]*$"}
  }
}
