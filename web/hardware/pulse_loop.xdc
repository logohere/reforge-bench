set_property -dict { PACKAGE_PIN H16 IOSTANDARD LVCMOS33 } [get_ports clk]
create_clock -name sys_clk -period 8.000 [get_ports clk]
set_property -dict { PACKAGE_PIN D20 IOSTANDARD LVCMOS33 } [get_ports reset_button]
set_property -dict { PACKAGE_PIN Y18 IOSTANDARD LVCMOS33 } [get_ports stimulus]
set_property PULLTYPE PULLDOWN [get_ports stimulus]
set_property -dict { PACKAGE_PIN Y19 IOSTANDARD LVCMOS33 DRIVE 4 SLEW SLOW } [get_ports heartbeat]
set_property -dict { PACKAGE_PIN G17 IOSTANDARD LVCMOS33 } [get_ports led_green]
set_property -dict { PACKAGE_PIN N15 IOSTANDARD LVCMOS33 } [get_ports fault]
set_false_path -from [get_ports stimulus] -to [get_pins stim_meta_reg/D]
set_false_path -from [get_ports reset_button] -to [get_pins reset_meta_reg/D]
